            'user_item_matrix': user_item_matrix,
            'product_features': product_features,
            'products': products_df
        }
        
        print(f"Trained recommendation model with {len(products_df)} products and {user_item_matrix.shape[0]} users")
        return self.recommendation_model
    
    def _extract_product_features(self, products_df):
        """Extract features from product data for content-based filtering"""
        # Convert categorical features to one-hot encoding
