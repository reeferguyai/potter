    def train_intent_classifier(self, training_data_path):
        """
        Train the intent classification model
        
        Args:
            training_data_path: Path to intent classification training data
        """
        # Load training data
        with open(training_data_path, 'r') as f:
            training_data = json.load(f)
        
        # Extract features and labels
        texts = [self._preprocess_text(example['text']) for example in training_data]
        intents = [example['intent'] for example in training_data]
        
        # Split into training and testing sets
        X_train, X_test, y_train, y_test = train_test_split(
            texts, intents, test_size=0.2, random_state=42
        )
        
        # Create a pipeline with TF-IDF vectorizer and Multinomial Naive Bayes
        self.intent_classifier = Pipeline([
            ('tfidf', TfidfVectorizer(ngram_range=(1, 3), min_df=2, max_df=0.85)),
            ('clf', MultinomialNB(alpha=0.1))
        ])
        
        # Train the model
        self.intent_classifier.fit(X_train, y_train)
        
        # Evaluate the model
        y_pred = self.intent_classifier.predict(X_test)
        accuracy = self.intent_classifier.score(X_test, y_test)
        print(f"Intent classifier accuracy: {accuracy:.4f}")
        print(classification_report(y_test, y_pred))
        
        return self.intent_classifier
    
    def _preprocess_text(self, text):
        """Preprocess text for NLP tasks"""
        # Convert to lowercase
        text = text.lower()
        
        # Remove special characters and digits
        text = re.sub(r'[^\w\s]', '', text)
        
        # Tokenize
        tokens = word_tokenize(text)
        
        # Lemmatize
        lemmatized_tokens = [self.lemmatizer.lemmatize(token) for token in tokens]
        
        # Join tokens back into string
        processed_text = ' '.join(lemmatized_tokens)
        
        return processed_text
    
