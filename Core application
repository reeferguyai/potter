        # Extract effects as features
        effect_features = pd.DataFrame(index=products_df.index)
        for effect in ['relaxation', 'energy', 'creativity', 'focus', 'sleep']:
            effect_features[f'effect_{effect}'] = products_df['effects'].apply(
                lambda x: 1 if effect in x else 0
            )
        
        # Combine features
        features = pd.concat([product_types, effect_features], axis=1)
        
        return features
    
