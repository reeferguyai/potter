        entity_patterns = {}
        for example in training_data:
            for entity in example['entities']:
                entity_type = entity['type']
                entity_value = entity['value']
                
                if entity_type not in entity_patterns:
                    entity_patterns[entity_type] = set()
                
                entity_patterns[entity_type].add(entity_value.lower())
        
        # Convert sets to lists for serialization
        for entity_type in entity_patterns:
            entity_patterns[entity_type] = list(entity_patterns[entity_type])
        
        self.entity_recognizer = entity_patterns
        
