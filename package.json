{
  "name": "potgrowhubstore",
  "version": "1.0.0",
  "description": "The AI-Powered Cannabis Ecosystem, Botanical Intelligence, 3D/AR Visualization & PWA E-Commerce Suite",
  "private": false,
  "homepage": "https://github.com/potgrowhub/potgrowhubstore#readme",
  "bugs": {
    "url": "https://github.com/potgrowhub/potgrowhubstore/issues",
    "email": "support@potgrowhub.local",
    "remote": "https://github.com/potgrowhub/potgrowhubstore/security/advisories",
    "discord": "https://discord.gg/potgrowhub",
    "twitter": "https://twitter.com/potgrowhub"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potgrowhub/potgrowhubstore.git",
    "directory": "/",
    "githubUrl": "https://github.com/potgrowhub/potgrowhubstore",
    "cloneUrl": "https://github.com/potgrowhub/potgrowhubstore.git"
  },
  "main": "script.js",
  "module": "script.js",
  "browser": {
    "./server.js": false,
    "./config.env": false,
    "./database.js": false,
    "./secrets.json": false
  },
  "scripts": {
    "start": "npx serve",
    "dev": "node server.js",
    "build": "echo 'Building static PWA bundle...' && mkdir -p dist && cp index.html style.css script.js manifest.json service-worker.js robots.txt sitemap.xml ads.txt seo.txt aeo.txt security.txt dist/",
    "lint": "eslint script.js service-worker.js server.js",
    "test": "node --test tests/**/*.test.js",
    "clean": "rm -rf dist .cache coverage .nyc_output logs/*.log",
    "docker:build": "docker build -t potgrowhubstore .",
    "docker:run": "docker run -p 3000:3000 --env-file config.env potgrowhubstore",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "test:watch": "node --watch --test tests/**/*.test.js",
    "coverage": "node --experimental-test-coverage --test tests/**/*.test.js",
    "prebuild": "npm run lint",
    "postbuild": "echo 'PWA bundle successfully built and verified.'",
    "prepare": "husky install",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "ai:train": "node ai/train_model.js",
    "security:scan": "npm audit --production && snyk test"
  },
