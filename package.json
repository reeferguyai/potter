    "conversation": {
      "allowNewChats": true,
      "allowRenameChats": true,
      "allowDeleteChats": true,
      "allowExportChats": true,
      "allowImportChats": true,
      "allowSearchChats": true,
      "allowPinChats": true,
      "allowArchiveChats": true,
      "allowConversationFolders": true,
      "allowConversationTags": true,
      "allowConversationNotes": true,
      "showTimestamps": true,
      "showTypingIndicator": true,
      "showStreamingCursor": true,
      "showAIStatus": true,
      "autoScroll": true,
      "preserveScrollPosition": true
