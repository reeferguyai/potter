  "config": {

    "application": {
      "name": "GanjaGroot AI",
      "shortName": "GanjaGroot",
      "version": "2.0.0",
      "environment": "development",
      "platform": "web",
      "language": "en-US",
      "timezone": "America/New_York",
      "defaultTheme": "dark",
      "enableBetaFeatures": true,
      "enableExperimentalFeatures": true
    },

    "server": {
      "host": "0.0.0.0",
      "port": 3000,
      "trustProxy": false,
      "compression": true,
      "requestTimeout": 120000,
      "keepAliveTimeout": 65000,
      "bodyLimit": "2mb",
      "enableCors": true,
      "enableHealthEndpoint": true,
      "enableMetrics": true,
      "enableRequestLogging": true
    },

    "ai": {
      "provider": "openai",
      "model": "gpt-5.6-luna",
      "fallbackModel": "gpt-5-mini",
      "temperature": 0.7,
      "topP": 1,
      "maxOutputTokens": 4096,
      "streaming": true,
      "streamMode": "delta",
      "rememberConversation": true,
      "maximumConversationMessages": 100,
      "maximumContextMessages": 40,
      "automaticSummaries": true,
      "automaticContextCompression": true,
      "contextWindowManagement": true,
      "personality": "friendly",
      "responseStyle": "helpful",
      "reasoningEnabled": true,
      "toolCalling": true,
      "parallelTools": true,
      "structuredResponses": true,
      "jsonResponses": true
    },

    "aiModes": {
      "default": "general",
      "general": {
        "enabled": true,
        "description": "General GanjaGroot AI assistant"
      },
      "expert": {
        "enabled": true,
        "description": "Detailed expert-level responses"
      },
      "creative": {
        "enabled": true,
        "description": "Creative brainstorming and idea generation"
      },
      "research": {
        "enabled": true,
        "description": "Research-oriented analysis"
      },
      "teacher": {
        "enabled": true,
        "description": "Explains difficult subjects step-by-step"
      },
      "coach": {
        "enabled": true,
        "description": "Planning, productivity and guidance"
      },
      "technical": {
        "enabled": true,
        "description": "Programming and technical assistance"
      },
      "concise": {
        "enabled": true,
        "description": "Short direct answers"
      },
      "deepDive": {
        "enabled": true,
        "description": "Extremely detailed analysis"
      },
      "brainstorm": {
        "enabled": true,
        "description": "Idea generation mode"
      },
      "debate": {
        "enabled": true,
        "description": "Balanced arguments and counterarguments"
      },
      "interviewer": {
        "enabled": true,
        "description": "Interactive question and answer mode"
      },
      "storyteller": {
        "enabled": true,
        "description": "Creative storytelling mode"
      },
      "developer": {
        "enabled": true,
        "description": "Software engineering mode"
      },
      "analyst": {
        "enabled": true,
        "description": "Data and decision analysis"
      }
    },

    "memory": {
      "enabled": true,
      "provider": "local-json",
      "database": "data/memory.json",
      "sessionMemory": true,
      "conversationMemory": true,
      "longTermMemory": true,
      "userPreferences": true,
      "topicMemory": true,
      "contextMemory": true,
      "summaryMemory": true,
      "toolMemory": true,
      "memorySearch": true,
      "memoryRanking": true,
      "memoryDeduplication": true,
      "automaticMemoryCleanup": true,
      "maximumStoredMessages": 1000,
      "maximumStoredSessions": 10000,
      "summaryAfterMessages": 50,
      "retentionDays": 365,
      "encryptMemory": false,
      "requireAuthentication": false
