    "voice": {
      "enabled": true,
      "input": true,
      "output": true,
      "continuousListening": false,
      "pushToTalk": true,
      "voiceActivation": false,
      "speechRecognition": true,
      "speechSynthesis": true,
      "autoSpeakResponses": false,
