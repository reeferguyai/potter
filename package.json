  "config": {
    "application": {
      "name": "PotGrowHub",
      "shortName": "PotGrowHub",
      "brand": "GanjaGroot AI",
      "version": "2.0.0",
      "environment": "development",
      "platform": "web",
      "language": "en-US",
      "timezone": "America/New_York",
      "defaultTheme": "dark",
      "enableBetaFeatures": false,
      "enableExperimentalFeatures": false
