# Remove accidental duplicates while preserving order.
seen = set()
sitemaps = [x for x in sitemaps if not (x in seen or seen.add(x))]

lines = [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
]
for name in sitemaps:
    lines += [
        "  <sitemap>",
        f"    <loc>{domain}{name}</loc>",
        "  </sitemap>"
    ]
lines.append("</sitemapindex>")
xml_text = "\n".join(lines) + "\n"

# Parse to guarantee well-formed XML.
ET.fromstring(xml_text)
out = Path("/mnt/data/sitemap.xml")
out.write_text(xml_text, encoding="utf-8")

# Basic structural checks.
assert xml_text.startswith('<?xml version="1.0" encoding="UTF-8"?>')
assert xml_text.count("<sitemap>") == len(sitemaps)
assert all(f"<loc>{domain}{name}</loc>" in xml_text for name in sitemaps)

print(f"Created and XML-parsed successfully: {out}")
print(f"Child sitemaps listed: {len(sitemaps)}")
print("Important: the index is syntactically valid, but each listed child sitemap must exist at its URL to avoid Google/Bing 'couldn't fetch' errors.")
